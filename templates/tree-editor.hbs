<p class="lg-sub">{{wanted.name}} — tropy ułożone wg głębokości (korzenie na górze)</p>

<div class="lg-node-editor-list">
  {{#each nodes as |n|}}
  <div class="lg-node-edit-row" data-node-id="{{n.id}}">
    <div class="lg-node-edit-grid">
      <label>Nazwa<input type="text" data-field="name" value="{{n.name}}" /></label>
      <label>DC<input type="number" data-field="dc" value="{{n.dc}}" /></label>
      <label>Waga<input type="number" data-field="weight" value="{{n.weight}}" /></label>
      <label>Logika rodziców
        <select data-field="parentLogic">
          <option value="AND" {{#if (eq n.parentLogic 'AND')}}selected{{/if}}>AND</option>
          <option value="OR" {{#if (eq n.parentLogic 'OR')}}selected{{/if}}>OR</option>
        </select>
      </label>
    </div>
    <label class="lg-parents-label">Rodzice (Ctrl/Cmd = wiele, w tym z innych poszukiwanych)
      <select data-field="parents" multiple size="4">
        {{#each ../parentOptions as |opt|}}
          <option value="{{opt.key}}" {{#if (includes n.parentKeys opt.key)}}selected{{/if}}>{{opt.label}}</option>
        {{/each}}
      </select>
    </label>
    <div class="lg-node-edit-actions">
      <button type="button" data-action="saveNode">Zapisz</button>
      <button type="button" data-action="deleteNode" class="lg-danger">Usuń</button>
    </div>
  </div>
  {{/each}}
</div>

<button type="button" data-action="addNode" class="lg-add-wanted"><i class="fas fa-plus"></i> Nowy trop</button>
