<div class="lg-tabs">
  <button type="button" class="{{#if (eq activeTab 'active')}}active{{/if}}" data-action="switchTab" data-tab="active">
    Aktywni <span class="lg-muted">{{active.length}}</span>
  </button>
  <button type="button" class="{{#if (eq activeTab 'caught')}}active{{/if}}" data-action="switchTab" data-tab="caught">
    Schwytani <span class="lg-muted">{{caught.length}}</span>
  </button>
</div>

{{#if (eq activeTab 'active')}}
<div class="lg-wanted-list">
  {{#each active as |w|}}
    <div class="lg-wanted-row" data-wanted-id="{{w.id}}" data-action="openWanted">
      <img src="{{w.img}}" />
      <div class="lg-wanted-main">
        <p class="lg-title">{{w.name}}</p>
        <p class="lg-sub">{{w.mainCrime}} · śledztwo {{w.progress}}%</p>
      </div>
      <p class="lg-gold">{{w.gold}} zł</p>
      <i class="fas fa-chevron-right"></i>
    </div>
  {{else}}
    <p class="lg-empty">Brak aktywnych poszukiwanych.</p>
  {{/each}}
</div>
{{else}}
<div class="lg-wanted-list lg-caught">
  {{#each caught as |w|}}
    <div class="lg-wanted-row" data-wanted-id="{{w.id}}" data-action="openWanted">
      <img src="{{w.img}}" />
      <div class="lg-wanted-main">
        <p class="lg-title">{{w.name}}</p>
        <p class="lg-sub">Schwytany</p>
      </div>
      <p class="lg-gold">{{w.gold}} zł</p>
    </div>
  {{else}}
    <p class="lg-empty">Nikogo jeszcze nie schwytano.</p>
  {{/each}}
</div>
{{/if}}

{{#if isGM}}
<button type="button" class="lg-add-wanted" data-action="createWanted"><i class="fas fa-plus"></i> Nowy poszukiwany</button>
{{/if}}
